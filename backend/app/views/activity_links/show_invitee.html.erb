<% content_for :title, @og_title %>

<section class="activity-link-invitation w-full max-w-xl mx-auto space-y-6">
  <h1 class="text-2xl font-semibold"><%= @og_title %></h1>
  <p><%= t("activities.invitee_body") %></p>
  <div class="flex gap-4">
    <%= button_to t("activities.accept_cta"), accept_member_activity_path(@activity), method: :post, class: "underline" %>
    <%= button_to t("activities.decline_cta"), decline_member_activity_path(@activity), method: :post, class: "underline" %>
  </div>
</section>
