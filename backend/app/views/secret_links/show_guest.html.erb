<% content_for :title, @og_title %>
<% content_for :head do %>
  <meta property="og:title" content="<%= @og_title %>">
  <meta property="og:description" content="<%= t('secret_links.og_description') %>">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="<%= @og_title %>">
<% end %>

<section class="secret-link-invitation w-full max-w-xl mx-auto space-y-6">
  <h1 class="text-2xl font-semibold"><%= @og_title %></h1>
  <p><%= t("secret_links.guest_body") %></p>
  <div class="flex gap-4">
    <%= link_to t("secret_links.login_cta"), new_session_path(return_to: @return_to), class: "underline" %>
    <%= link_to t("secret_links.signup_cta"), new_signup_path(return_to: @return_to), class: "underline" %>
  </div>
</section>
