<% content_for :title, t("admin.titles.audit") %>
<h1><%= t("admin.headings.audit") %></h1>

<%= form_with url: admin_audit_events_path, method: :get, local: true do %>
  <label>
    <%= t("admin.copy.action_filter") %>
    <input type="text" name="action_filter" value="<%= @action_filter %>">
  </label>
  <button type="submit"><%= t("admin.copy.filter") %></button>
<% end %>

<ul>
  <% @audit_events.each do |event| %>
    <li>
      <%= link_to admin_audit_event_path(event) do %>
        <%= event.action %> — <%= event.auditable_type %> #<%= event.auditable_id %>
      <% end %>
      <% if revertable_event?(event) %>
        <%= button_to t("admin.actions.revert"), revert_admin_audit_event_path(event), method: :post %>
      <% end %>
    </li>
  <% end %>
</ul>
