<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t("admin.nav.brand") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header class="container mx-auto px-5 py-4 border-b">
      <nav class="flex gap-4 items-center">
        <strong><%= t("admin.nav.brand") %></strong>
        <%= link_to t("admin.nav.reports"), admin_reports_path %>
        <%= link_to t("admin.nav.audit"), admin_audit_events_path %>
        <%= link_to t("admin.nav.style_guide"), admin_style_guide_path %>
      </nav>
      <% if flash[:notice].present? %>
        <p class="mt-2"><%= flash[:notice] %></p>
      <% end %>
      <% if flash[:alert].present? %>
        <p class="mt-2"><%= flash[:alert] %></p>
      <% end %>
    </header>
    <main class="container mx-auto mt-8 px-5">
      <%= yield %>
    </main>
  </body>
</html>
