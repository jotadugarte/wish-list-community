<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t("member.shell.app_name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-stone-50 text-stone-900">
    <nav class="member-nav border-b border-stone-200 bg-white" aria-label="<%= t("member.shell.nav_label") %>">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-4 px-4 py-3">
        <span class="font-semibold"><%= t("member.shell.app_name") %></span>
        <%= link_to t("member.shell.nav.wishlists"), member_wishlists_path %>
        <%= link_to t("member.shell.nav.shared"), member_shared_path %>
        <%= link_to t("member.shell.nav.friends"), member_friends_path %>
        <%= link_to t("member.shell.nav.reservations"), member_reservations_path %>
        <%= link_to t("member.shell.nav.notifications"), member_notifications_path %>
        <%= link_to t("member.shell.nav.settings"), member_settings_path %>
      </div>
    </nav>
    <main class="mx-auto max-w-5xl px-4 py-6">
      <%= yield %>
    </main>
  </body>
</html>
