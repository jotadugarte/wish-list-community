    <h1 class="text-3xl font-semibold"><%= t("legal.privacy.heading") %></h1>
    <p class="text-sm text-gray-600"><%= t("legal.placeholder_notice") %></p>
  </header>

  <section lang="es" aria-label="Política de Privacidad en español">
    <h2 class="text-xl font-semibold">Español</h2>
    <h3 class="text-lg font-medium">Política de Privacidad</h3>
    <p><%= t("legal.privacy.body_es") %></p>
