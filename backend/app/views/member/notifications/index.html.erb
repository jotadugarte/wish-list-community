<section class="space-y-4">
  <h1 class="text-2xl font-semibold"><%= t("member.shell.sections.notifications") %></h1>
  <% if @notifications.empty? %>
    <p><%= t("member.notifications.empty") %></p>
  <% else %>
    <ul class="space-y-3">
      <% @notifications.each do |note| %>
        <li class="border-b border-stone-200 pb-2">
          <strong><%= note.title %></strong>
          <p class="text-sm"><%= note.body %></p>
          <% if note.read_at.blank? %>
            <%= button_to t("member.notifications.mark_read"), mark_read_member_notification_path(note), method: :post %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
