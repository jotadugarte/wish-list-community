<section class="space-y-4">
  <div class="flex items-center justify-between gap-4">
    <h1 class="text-2xl font-semibold"><%= t("member.shell.sections.wishlists") %></h1>
    <%= link_to t("member.wishlists.new"), new_member_wishlist_path %>
  </div>
  <% if @wishlists.empty? %>
    <p><%= t("member.wishlists.empty") %></p>
  <% else %>
    <ul class="space-y-2">
      <% @wishlists.each do |wishlist| %>
        <li>
          <%= link_to wishlist.title, member_wishlist_path(wishlist) %>
          <span class="text-sm text-stone-500">(<%= wishlist.privacy_mode %>)</span>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
