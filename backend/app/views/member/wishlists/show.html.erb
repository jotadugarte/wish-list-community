<section class="space-y-4">
  <h1 class="text-2xl font-semibold"><%= @wishlist.title %></h1>
  <p><%= t("member.wishlists.privacy") %>: <%= @wishlist.privacy_mode %></p>
  <% if @wishlist.privacy_mode == "shared" && @wishlist.share_token.present? %>
    <p><%= t("member.wishlists.secret_link") %>: <%= secret_link_url(share_token: @wishlist.share_token) %></p>
    <%= button_to t("member.wishlists.rotate"), rotate_share_token_member_wishlist_path(@wishlist), method: :post %>
  <% end %>
  <p>
    <%= link_to t("member.wishlists.edit"), edit_member_wishlist_path(@wishlist) %>
    <%= button_to t("member.wishlists.delete"), member_wishlist_path(@wishlist), method: :delete, form: { data: { turbo_confirm: t("member.wishlists.confirm_delete") } } %>
  </p>

  <h2 class="text-xl font-semibold"><%= t("member.items.heading") %></h2>
  <%= link_to t("member.items.new"), new_member_wishlist_item_path(@wishlist) %>
  <ul class="space-y-2">
    <% @items.each do |item| %>
      <li>
        <%= link_to item.title, edit_member_item_path(item) %>
        <%= button_to t("member.items.delete"), member_item_path(item), method: :delete %>
      </li>
    <% end %>
  </ul>

  <h2 class="text-xl font-semibold"><%= t("member.wishlists.shares") %></h2>
  <%= form_with url: member_wishlist_shares_path(@wishlist), method: :post do %>
    <%= label_tag :user_id, t("member.wishlists.share_user_id") %>
    <%= number_field_tag :user_id, nil, required: true %>
    <%= submit_tag t("member.wishlists.add_share") %>
  <% end %>
  <ul>
    <% @shares.each do |share| %>
      <li>
        @<%= share.user.username %>
        <%= button_to t("member.wishlists.remove_share"), member_wishlist_share_path(@wishlist, share.user_id), method: :delete %>
      </li>
    <% end %>
  </ul>
</section>
