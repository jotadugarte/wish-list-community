<section class="space-y-4 max-w-md">
  <h1 class="text-2xl font-semibold"><%= t("member.wishlists.new") %></h1>
  <%= form_with model: @wishlist, url: member_wishlists_path, method: :post do |f| %>
    <div>
      <%= f.label :title %>
      <%= f.text_field :title, required: true %>
    </div>
    <%= f.submit t("member.wishlists.create") %>
  <% end %>
</section>
