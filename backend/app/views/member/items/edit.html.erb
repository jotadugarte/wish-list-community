<section class="space-y-4 max-w-lg" data-controller="image-compress">
  <h1 class="text-2xl font-semibold"><%= t("member.items.edit") %></h1>
  <% if flash[:alert].present? %><p class="text-red-600"><%= flash[:alert] %></p><% end %>
  <%= form_with model: @item, url: member_item_path(@item), method: :patch, html: { multipart: true } do |f| %>
    <div>
      <%= f.label :title %>
      <%= f.text_field :title, required: true %>
    </div>
    <div>
      <%= label_tag "item[links_text]", t("member.items.links_label") %>
      <%= text_area_tag "item[links_text]",
            @item.item_links.order(:position).limit(20).pluck(:url).join("\n"),
            rows: 4,
            placeholder: "https://…" %>
      <p class="text-sm text-stone-500"><%= t("member.items.links_hint") %></p>
    </div>
    <div>
      <%= label_tag :images, t("member.items.images") %>
      <%= file_field_tag "images[]", multiple: true, accept: "image/*",
            data: { image_compress_target: "input", action: "change->image-compress#compress" } %>
      <p class="text-sm text-stone-500"><%= t("member.items.compress_hint") %></p>
    </div>
    <%= f.submit t("member.items.save") %>
  <% end %>
</section>
