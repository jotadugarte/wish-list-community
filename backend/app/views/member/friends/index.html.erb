<section class="space-y-4">
  <h1 class="text-2xl font-semibold"><%= t("member.shell.sections.friends") %></h1>

  <h2 class="text-lg font-medium"><%= t("member.friends.incoming") %></h2>
  <% if @incoming.empty? %>
    <p class="text-stone-600"><%= t("member.friends.incoming_empty") %></p>
  <% else %>
    <ul class="space-y-2 mb-6">
      <% @incoming.each do |friendship| %>
        <% requester = friendship.requester %>
        <li class="flex items-center gap-3">
          <span>@<%= requester.username %></span>
          <%= button_to t("member.friends.accept"), member_friendship_path(friendship), method: :patch %>
          <%= button_to t("member.friends.decline"), member_friendship_path(friendship), method: :delete %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <h2 class="text-lg font-medium"><%= t("member.friends.accepted") %></h2>
  <% if @friends.empty? %>
    <p class="text-stone-600"><%= t("member.friends.empty") %></p>
  <% else %>
    <ul class="space-y-2">
      <% @friends.each do |friendship| %>
        <% other = friendship.requester_id == current_user.id ? friendship.addressee : friendship.requester %>
        <li class="flex items-center gap-3">
          <span>@<%= other.username %></span>
          <%= button_to t("member.friends.remove"), member_friendship_path(friendship), method: :delete %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
