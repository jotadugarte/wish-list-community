<section class="space-y-4">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold"><%= t("activities.index_heading") %></h1>
    <%= link_to t("activities.new_cta"), new_member_activity_path, class: "underline" %>
  </div>
  <ul class="space-y-2">
    <% @activities.each do |activity| %>
      <li>
        <%= link_to activity.name, member_activity_path(activity), class: "underline" %>
        <span class="text-sm opacity-70"><%= activity.status %></span>
      </li>
    <% end %>
  </ul>
</section>
